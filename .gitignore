# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build / compile output ────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Environment & secrets ─────────────────────────────────────────────────────
# All .env* variants are blocked; only .env.example files are allowed through.
.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Prisma generated client ───────────────────────────────────────────────────
# Re-generated from schema.prisma on every `prisma generate` — never committed.
src/generated/
**/src/generated/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Misc ──────────────────────────────────────────────────────────────────────
*.local
