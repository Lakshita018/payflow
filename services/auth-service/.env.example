# ============================================================
# PayFlow — Auth Service environment variables
# ============================================================
# HOW TO USE
#   cp .env.example .env
#   Fill in the DATABASE_URL with your Neon connection string.
#   The JWT secrets below are safe pre-generated dev values —
#   replace them with your own for any shared or production environment.
#   Never commit .env to version control.
#
# REQUIRED vs OPTIONAL (local development)
#   DATABASE_URL        REQUIRED  — Neon or local PostgreSQL
#   JWT_ACCESS_SECRET   REQUIRED  — min 32 chars
#   JWT_REFRESH_SECRET  REQUIRED  — min 32 chars, must differ from ACCESS
#   REDIS_URL           OPTIONAL  — needed only when idempotency keys are wired (Phase 5)
#   RABBITMQ_URL        OPTIONAL  — needed only when event publishing is wired (Phase 6)
#   All other variables have safe defaults and can be left as-is locally.
# ============================================================


# ─── Server ──────────────────────────────────────────────────────────────────
# NODE_ENV controls:
#   • trust-proxy setting (enabled in production for accurate client IPs)
#   • globalThis Prisma pool caching (enabled in development/test to survive hot-reloads)
#   • CORS localhost allowance (always allowed in non-production)
NODE_ENV=development

# TCP port the HTTP server listens on.
PORT=3001

# Identifies this process in structured logs. Change if running multiple
# instances with different roles.
SERVICE_NAME=auth-service


# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Two formats are supported:
#
#   Local Docker (no TLS):
#     postgresql://payflow:payflow@localhost:5432/payflow
#
#   Neon serverless (TLS required — append ?sslmode=require):
#     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/payflow?sslmode=require
#
# The Prisma pg adapter (PrismaPg) uses this string to create a pg.Pool.
# One pool per process; max 10 connections by default.
DATABASE_URL=postgresql://neondb_owner:npg_OBvaefE86PoS@ep-holy-glitter-azn6pa1r.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require



# ─── Redis ───────────────────────────────────────────────────────────────────
# OPTIONAL — leave blank or omit entirely if you do not have Redis running.
# The server starts and all endpoints work without it. Redis is only needed
# once idempotency-key enforcement is added to POST /transactions/transfer.
#
# Formats:
#   Local Docker (no TLS):   redis://localhost:6379
#   Upstash (TLS required):  rediss://default:token@host.upstash.io:6379
#
# To start Redis locally with Docker (one command, no compose needed):
#   docker run -d --name payflow-redis -p 6379:6379 redis:7-alpine
#
# Uncomment when ready:
# REDIS_URL=redis://localhost:6379


# ─── RabbitMQ ────────────────────────────────────────────────────────────────
# OPTIONAL — leave blank or omit entirely if you do not have RabbitMQ running.
# The server starts and all endpoints work without it. RabbitMQ is only needed
# once async event publishing is added (payment.* and audit.* events).
#
# Formats:
#   Local Docker (no TLS):   amqp://guest:guest@localhost:5672
#   CloudAMQP (TLS):         amqps://user:pass@host.cloudamqp.com/vhost
#
# To start RabbitMQ locally with Docker (includes management UI at :15672):
#   docker run -d --name payflow-rabbit -p 5672:5672 -p 15672:15672 rabbitmq:3.13-management-alpine
#
# Uncomment when ready:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672


# ─── JWT ─────────────────────────────────────────────────────────────────────
# Two separate secrets enforce token-type separation: an access token cannot
# be presented as a refresh token (type-confusion defence in jwt.ts).
#
# SECURITY REQUIREMENTS
#   • Each secret must be at least 32 characters (enforced by Zod schema).
#   • They must differ from each other.
#   • In production use cryptographically random values of ≥64 hex chars.
#
# Generate new secrets (run in any terminal):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The values below are pre-generated development secrets — safe to commit in
# .env.example; do NOT use these in production or staging.
JWT_ACCESS_SECRET=8dbd7b085e13eaa61d7af45294a74602a48cee636a6e4a3f3f33317121d54dde08fa32c1426b440647213b9a3e71222f
JWT_REFRESH_SECRET=da71096e9c3bed65c2b548b78ff954428ce358278f92ee935ce8dfcbc467e04666ccefa0db8f842fa8f009e6e33c4d28

# How long an access token is valid. After this window the client must call
# POST /auth/refresh. Short window = smaller exposure if a token is leaked.
# Accepted format: ms library strings — "15m", "1h", "2d", etc.
JWT_ACCESS_EXPIRES_IN=15m

# How long a refresh token is valid. Only one refresh token exists per user
# (single-session design): a new login on any device rotates the stored hash
# and invalidates all previous refresh tokens for that user.
JWT_REFRESH_EXPIRES_IN=7d


# ─── Bcrypt ──────────────────────────────────────────────────────────────────
# Cost factor for bcrypt password hashing. Affects both registration speed
# and brute-force resistance. Formula: time ≈ 2^rounds ms on modern hardware.
#   10 rounds ≈  65 ms  (NIST minimum)
#   12 rounds ≈ 250 ms  (recommended default)
#   14 rounds ≈   1 s   (high-security environments)
# The seed script reads this value too, so seeded passwords use the same cost.
BCRYPT_SALT_ROUNDS=12


# ─── Logging ─────────────────────────────────────────────────────────────────
# Pino log level. Logs are emitted as JSON in all environments.
# Pipe through pino-pretty for human-readable output during development:
#   npm run dev | npx pino-pretty
#
# Levels (least → most verbose): fatal error warn info debug trace
# Recommended: 'info' for production, 'debug' locally when tracing requests.
LOG_LEVEL=info


# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to make cross-origin requests.
# Empty string means no origin is explicitly allowed via this variable.
# NOTE: localhost:* is ALWAYS allowed in NODE_ENV=development regardless
# of this value, so you do not need to list localhost here.
#
# Production example:
#   CORS_ALLOWED_ORIGINS=https://payflow.vercel.app,https://admin.payflow.io
CORS_ALLOWED_ORIGINS=


# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Applied only to auth endpoints: POST /auth/login, /auth/register, /auth/refresh.
# All other API routes are NOT rate-limited by default (see roadmap Phase 4).
#
# RATE_LIMIT_AUTH_MAX  — max requests allowed per IP within the window.
# RATE_LIMIT_WINDOW_MS — sliding window duration in milliseconds.
#
# Default: 10 requests per 15 minutes per IP.
# Raise RATE_LIMIT_AUTH_MAX during local development to avoid blocking yourself
# while testing (e.g. set to 100).
# Raised to 100 for development — lower this in production (e.g. 10).
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_WINDOW_MS=900000
