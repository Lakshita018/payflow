# Auth Service environment variables
# Copy this file to .env and fill in real values — never commit .env

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
SERVICE_NAME=auth-service

# ─── Database ────────────────────────────────────────────────────────────────
# Local:  postgresql://payflow:payflow@localhost:5432/payflow
# Docker: postgresql://payflow:payflow@postgres:5432/payflow
DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local:  redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ──────────────────────────────────────────────────────────────────
# Salt rounds for password hashing. Min 10, max 20. Default 12 (~250 ms/hash).
BCRYPT_SALT_ROUNDS=12

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to block all cross-origin requests.
# Example: https://app.payflow.io,https://admin.payflow.io
CORS_ALLOWED_ORIGINS=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Auth routes (/login, /register, /refresh): max requests per window
RATE_LIMIT_AUTH_MAX=10
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
