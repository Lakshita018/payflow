generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String             @id @default(uuid())
  email                   String             @unique
  payflowId               String             @unique
  passwordHash            String
  refreshTokenHash        String?
  /// SHA-256 hex hash of the raw reset token (never stored in plaintext)
  passwordResetToken      String?
  /// UTC expiry for the reset token — null when no reset is pending
  passwordResetExpiry     DateTime?
  /// User-chosen display name; defaults to the payflowId prefix when null
  displayName             String?
  /// E.164 phone number (optional)
  phone                   String?
  /// Public URL or base64 data URI for the user's avatar
  avatarUrl               String?
  /// User preferences stored as a JSON blob
  emailNotifications      Boolean            @default(true)
  pushNotifications       Boolean            @default(true)
  /// light | dark | system
  themePreference         String             @default("system")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  favouritedBy              FavouriteContact[] @relation("FavouritedUsers")
  favourites                FavouriteContact[] @relation("UserFavourites")
  receivedTransactions      Transaction[]      @relation("ReceivedTransactions")
  sentTransactions          Transaction[]      @relation("SentTransactions")
  wallet                    Wallet?
  notifications             Notification[]
  incomingPaymentRequests   PaymentRequest[]   @relation("ReceivedRequests")
  outgoingPaymentRequests   PaymentRequest[]   @relation("SentRequests")
  idempotencyKeys           IdempotencyKey[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  amount     Decimal  @db.Decimal(18, 2)
  /// PENDING | COMPLETED | FAILED
  status     String   @default("COMPLETED")
  /// ADD_MONEY | TRANSFER
  type       String   @default("TRANSFER")
  /// CREDIT | DEBIT
  direction  String   @default("CREDIT")
  note       String?
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedTransactions", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentTransactions", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model FavouriteContact {
  id            String   @id @default(uuid())
  userId        String
  contactUserId String
  createdAt     DateTime @default(now())
  contactUser   User     @relation("FavouritedUsers", fields: [contactUserId], references: [id], onDelete: Cascade)
  user          User     @relation("UserFavourites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contactUserId])
  @@map("favourite_contacts")
}

/// MONEY_RECEIVED | MONEY_SENT | WALLET_TOPPED_UP | PASSWORD_CHANGED | PROFILE_UPDATED
model Notification {
  id        String   @id @default(uuid())
  userId    String
  /// MONEY_RECEIVED | MONEY_SENT | WALLET_TOPPED_UP | PASSWORD_CHANGED | PROFILE_UPDATED
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  /// Optional reference to a related transaction id
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// PENDING | ACCEPTED | REJECTED | CANCELLED | EXPIRED
model PaymentRequest {
  id          String    @id @default(uuid())
  requesterId String
  receiverId  String
  amount      Decimal   @db.Decimal(18, 2)
  note        String?
  /// PENDING | ACCEPTED | REJECTED | CANCELLED | EXPIRED
  status      String    @default("PENDING")
  /// Optional expiry — if set, request is treated as EXPIRED after this date
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  requester   User      @relation("SentRequests",     fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User      @relation("ReceivedRequests", fields: [receiverId],  references: [id], onDelete: Cascade)

  @@index([receiverId, createdAt(sort: Desc)])
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("payment_requests")
}

/// Idempotency fence for money-transfer operations.
/// One record per (userId, idempotencyKey); the unique constraint is the lock.
/// requestHash detects payload mismatches → 409.
/// response stores the JSON-serialised success payload for replay.
/// expiresAt defaults to 24 h after creation; rows past this date are eligible
/// for cleanup by the scheduled purge job.
model IdempotencyKey {
  id             String   @id @default(uuid())
  idempotencyKey String
  userId         String
  /// SHA-256 hex of the canonical request body
  requestHash    String
  /// JSON-serialised TransferResult for idempotent replay
  response       String
  /// COMPLETED (only state for now; future-proof for IN_FLIGHT)
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())
  /// Keys expire 24 h after creation
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
