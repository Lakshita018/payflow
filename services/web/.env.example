# ============================================================
# PayFlow Web — environment variables
# ============================================================
# HOW TO USE
#   cp .env.example .env.local
#   Set VITE_API_BASE_URL to point at your running backend.
#   Vite only exposes variables prefixed with VITE_ to the browser bundle.
#   Never commit .env.local to version control.
# ============================================================

# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the PayFlow auth-service.
#   Local development : http://localhost:3001
#   Render deployment : https://<your-service>.onrender.com
#
# Used by src/lib/axios.ts to construct every API request URL.
# If this variable is absent the axios client falls back to http://localhost:3001.
VITE_API_BASE_URL=http://localhost:3001
