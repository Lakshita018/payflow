# ── Environment & secrets ─────────────────────────────────────────────────────
# .env.local holds VITE_API_BASE_URL and any future browser-side secrets.
# The root .gitignore already blocks .env/.env.*, but explicit is safer.
.env
.env.*
!.env.example

# ── Build ─────────────────────────────────────────────────────────────────────
# Vite writes the production bundle here.
dist/

# ── Vite cache ────────────────────────────────────────────────────────────────
.vite/

# ── Test artefacts ────────────────────────────────────────────────────────────
coverage/
